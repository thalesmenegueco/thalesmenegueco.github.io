{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portfolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/portfolio",
      "sourceRoot": "projects/portfolio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/portfolio",
            "browser": "projects/portfolio/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/portfolio/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["libs/shared-plotting/styles"]
            },
            "assets": [
              "projects/portfolio/src/404.html",
              {
                "glob": "**/*",
                "input": "projects/portfolio/public"
              }
            ],
            "styles": [
              "projects/portfolio/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portfolio:build:production"
            },
            "development": {
              "buildTarget": "portfolio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/portfolio/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["libs/shared-plotting/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portfolio/public"
              }
            ],
            "styles": [
              "projects/portfolio/src/styles.scss"
            ]
          }
        }
      }
    },
    "ml-platform": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ml-platform",
      "sourceRoot": "projects/ml-platform/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/ml-platform",
            "browser": "projects/ml-platform/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ml-platform/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["libs/shared-plotting/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ml-platform/public"
              }
            ],
            "styles": [
              "projects/ml-platform/src/styles.scss",
              "node_modules/katex/dist/katex.min.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                },
                {
                  "type": "any",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ml-platform:build:production"
            },
            "development": {
              "buildTarget": "ml-platform:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/ml-platform/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["libs/shared-plotting/styles"]
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ml-platform/public"
              }
            ],
            "styles": [
              "projects/ml-platform/src/styles.scss",
              "node_modules/katex/dist/katex.min.css"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
